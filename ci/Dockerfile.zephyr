FROM ubuntu:26.04 AS zephyr

ARG ZEPHYR_VERSION=2.4.0
# Prevent prompts configuring tzdata
ENV DEBIAN_FRONTEND=noninteractive
RUN ln -fs /usr/share/zoneinfo/America/New_York /etc/localtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build gperf bzip2 \
    ccache dfu-util device-tree-compiler wget \
    python3-dev python3-pip python3-setuptools python3-tk python3-wheel xz-utils file \
    make gcc gcc-multilib g++-multilib libsdl2-dev \
    clang

RUN pip3 install --break-system-packages -U west

ENV WEST_BASE=/zephyrproject
ENV ZEPHYR_BASE=${WEST_BASE}/zephyr
WORKDIR ${WEST_BASE}
RUN git clone https://github.com/zephyrproject-rtos/zephyr.git -b v${ZEPHYR_VERSION} --filter=tree:0 ${ZEPHYR_BASE}
# Needed for building as root
RUN if [ "${ZEPHYR_VERSION}" = "2.3.0" ]; then \
        cd ${ZEPHYR_BASE}; \
        git cherry-pick -n 66d1b3ce10635dd9988898479ce8b8f6516a98df; \
    fi
RUN west init -l ${ZEPHYR_BASE}
RUN west update --narrow --fetch-opt=--filter=tree:0

# Workaround for a bug in Zephyr's gen_kobject_list.py (present in 2.3.0 -
# 3.7.0): die_get_type_offset() adds the CU offset to every DW_AT_type
# reference, but DW_FORM_ref_addr references (emitted by rustc for cross-CU
# type references) are already file-absolute. The mangled offset can land on
# an unrelated kobject type and fail the build (e.g. 2.7.3 x
# nucleo_l552ze_q x samples/serial). Remove once a fixed Zephyr release is
# pinned.
RUN <<'EOF'
python3 -c '
import os
p = None
for cand in ("/zephyrproject/zephyr/scripts/gen_kobject_list.py",
            "/zephyrproject/zephyr/scripts/build/gen_kobject_list.py"):
    if os.path.exists(cand):
        p = cand
        break
assert p, "gen_kobject_list.py not found"
s = open(p).read()
old = "    return die.attributes[\"DW_AT_type\"].value + die.cu.cu_offset"
new = ("    attr = die.attributes[\"DW_AT_type\"]\n"
       "    # DW_FORM_ref_addr is already file-absolute (e.g. rustc cross-CU refs)\n"
       "    if attr.form == \"DW_FORM_ref_addr\":\n"
       "        return attr.value\n"
       "    return attr.value + die.cu.cu_offset")
assert s.count(old) == 1, "unexpected gen_kobject_list.py"
open(p, "w").write(s.replace(old, new))
'
EOF
RUN pip3 install --break-system-packages -r ${ZEPHYR_BASE}/scripts/requirements.txt

ADD setup-sdk.sh /setup-sdk.sh
RUN /setup-sdk.sh
# Required for sanitycheck
ENV ZEPHYR_TOOLCHAIN_VARIANT=zephyr
# CMake >= 3.31 (as in ubuntu 26.04) removed compatibility with
# cmake_policy(VERSION < 3.5), which Zephyr 2.x modules (e.g. civetweb) still
# declare. No effect on Zephyr 3.x.
ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

# Rust toolchain stage.
#
# Built from the bare base image (rather than FROM zephyr) so its layers are
# keyed only on RUST_VERSION. When building multiple ZEPHYR_VERSIONs with the
# same Rust version, this stage is a cache hit after the first build instead
# of re-downloading/reinstalling the toolchain for every Zephyr version.
FROM ubuntu:26.04 AS rust

ARG RUST_VERSION=1.69.0
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget
RUN set -eux; \
    wget https://sh.rustup.rs -O rustup.sh; \
    sh rustup.sh -y --no-modify-path --profile minimal --default-toolchain ${RUST_VERSION}; \
    rm rustup.sh; \
    rustup --version; \
    cargo --version; \
    rustc --version; \
    # clippy is not in the minimal profile; needed by ci/clippy.sh
    rustup component add clippy;

# Final stage: zephyr base with the rust toolchain copied in. The COPY layers
# are local copies, so rebuilding them when either input stage changes is cheap.
FROM zephyr

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

COPY --from=rust ${RUSTUP_HOME} ${RUSTUP_HOME}
COPY --from=rust ${CARGO_HOME} ${CARGO_HOME}
RUN set -eux; \
    ln -sf ${CARGO_HOME}/bin/cargo /usr/bin/cargo; \
    ln -sf ${CARGO_HOME}/bin/rustup /usr/bin/rustup; \
    ln -sf ${CARGO_HOME}/bin/rustc /usr/bin/rustc;
